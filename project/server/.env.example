# Copy this file to server/.env and add your MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/feedbackhub?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_SECRET=choose_a_private_admin_registration_code
CLIENT_URL=http://localhost:5173
PORT=5000
# Optional: override demo account passwords before running npm run seed
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_CUSTOMER_PASSWORD=Customer@123
